classDiagram
    %% Phase 1 draft — kept for comparison with the final diagram in uml.mmd

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task_id) None
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +sort_by_time(tasks) list~Task~
        +detect_conflicts() list~str~
        +generate_plan(day) list~Task~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : owns
    Scheduler --> Owner : reads pets and tasks from
